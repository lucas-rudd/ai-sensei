{
    "name": "@spinach-backend/open-ai",
    "version": "1.0.0",
    "description": "A package for all OpenAI related integration logic",
    "private": true,
    "scripts": {
        "lint": "eslint $([ -z \"$GITHUB_WORKSPACE\" ] && echo \"\" || echo \"--output-file eslint_report.json --format json\") \"src/**/*.{js,ts,tsx}\"",
        "format": "prettier -w **/*.ts",
        "typecheck": "tsc --noEmit",
        "test": "jest --watch",
        "test:ci": "jest --ci --reporters=jest-junit --reporters=default --passWithNoTests --forceExit || true"
    },
    "jest-junit": {
        "outputDirectory": "reports",
        "outputName": "jest-junit.xml",
        "ancestorSeparator": " › ",
        "uniqueOutputName": "false",
        "reportTestSuiteErrors": "true"
    },
    "dependencies": {
        "@azure/openai": "^1.0.0-beta.4",
        "@spinach-backend/feature-toggle": "*",
        "openai": "^3.2.1",
        "@spinach-shared/utils": "*",
        "@spinach-backend/application-identifiers": "*",
        "@spinach-backend/metrics": "*"
    },
    "devDependencies": {},
    "peerDependencies": {
        "@types/jest": "*",
        "jest": "*",
        "jest-config": "*",
        "jest-environment-node": "*",
        "jest-junit": "*",
        "ts-jest": "*"
    }
}
